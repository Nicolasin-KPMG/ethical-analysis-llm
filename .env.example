# Copia este archivo a .env y ajusta los valores.
# docker-compose lee .env automaticamente.

# --- Base de datos (PostgreSQL + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tesis
# URL que usa el backend dentro de docker-compose (host = nombre del servicio "db").
DATABASE_URL=postgresql://postgres:postgres@db:5432/tesis

# --- Autenticacion (login con JWT) ---
# CAMBIA este secreto por uno propio (p. ej. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=720   # duracion de la sesion (12 h)

# --- Proveedor de LLM ---
LLM_PROVIDER=anthropic            # o: openai | local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini          # económico; sube a gpt-4o / gpt-4.1 para más calidad
# Endpoint compatible con OpenAI. Vacío = API de OpenAI. Se rellena para usar
# otro proveedor con el mismo cliente. Para el despliegue gratis con Gemini:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash   (ver deploy/DEPLOY_GRATIS.md)
OPENAI_BASE_URL=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# --- Proveedor de embeddings (pieza aparte: Anthropic no genera embeddings) ---
# Decisión del proyecto: embeddings locales con Ollama (gratis y offline).
# Es independiente del LLM: puedes usar Claude (arriba) + Ollama (aquí) a la vez.
EMBEDDING_PROVIDER=local          # o: hosted
EMBEDDING_MODEL_HOSTED=voyage-3
EMBEDDING_MODEL_LOCAL=bge-m3      # multilingüe, 1024 dims (ollama pull bge-m3)
EMBEDDING_DIM=1024                # debe coincidir con el modelo elegido (bge-m3 = 1024)
VOYAGE_API_KEY=                   # solo si usas el proveedor hospedado (Voyage)
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
# Endpoint compatible con OpenAI para embeddings (independiente del LLM).
# Para Gemini: https://generativelanguage.googleapis.com/v1beta/openai/
# con EMBEDDING_MODEL_OPENAI=gemini-embedding-001 (acepta dimensions=1024).
EMBEDDING_OPENAI_BASE_URL=
# Endpoint local compatible con OpenAI. Desde el contenedor, Ollama (que corre en
# el host) se alcanza por host.docker.internal, no por localhost.
EMBEDDING_LOCAL_BASE_URL=http://host.docker.internal:11434/v1

# --- RAG (recuperación) — controlan el contexto y el gasto de tokens ---
RAG_K_POR_CONSULTA=4              # fragmentos por cada consulta del LLM
RAG_MAX_FRAGMENTOS=10            # tope total de fragmentos enviados al análisis

# --- Despliegue gratis: Gemini (ver deploy/DEPLOY_GRATIS.md) ---
# API key de https://aistudio.google.com/apikey. La lee deploy/probar_gemini.sh
# (paso 0) y luego se copia al panel de Render como OPENAI_API_KEY.
GEMINI_API_KEY=

# --- Despliegue ---
# Orígenes permitidos por CORS, separados por coma. "*" abre todo (solo local).
CORS_ORIGINS=*
# APP_ENV=prod desactiva el --reload de uvicorn (ver entrypoint.sh).
APP_ENV=dev

# --- Frontend ---
# URL del backend vista desde el navegador del usuario.
# (8001 en el host porque 8000 suele estar ocupado; ver docker-compose.yml)
NEXT_PUBLIC_API_URL=http://localhost:8001
