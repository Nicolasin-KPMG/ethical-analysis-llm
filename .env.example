# Copia este archivo a .env y ajusta los valores.
# docker-compose lee .env automaticamente.
#
# MINIMO PARA ARRANCAR: pon tu clave en OPENAI_API_KEY y deja todo lo demas
# como esta. Esa clave cubre el LLM y los embeddings.

# --- Base de datos (PostgreSQL + pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tesis
# URL que usa el backend dentro de docker-compose (host = nombre del servicio "db").
DATABASE_URL=postgresql://postgres:postgres@db:5432/tesis

# --- Autenticacion (login con JWT) ---
# CAMBIA este secreto por uno propio (p. ej. `openssl rand -hex 32`).
JWT_SECRET=dev-secret-cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=720   # duracion de la sesion (12 h)

# --- Proveedor de LLM ---
# openai = configuracion de la tesis (los resultados del Cap. 7 son con gpt-4.1).
LLM_PROVIDER=openai               # openai | anthropic | local
OPENAI_API_KEY=                   # <-- RELLENA ESTO (sk-proj-...)
OPENAI_MODEL=gpt-4.1              # gpt-4o-mini es mas barato, con menos calidad
# Endpoint compatible con OpenAI. Vacio = API de OpenAI. Se rellena para usar
# otro proveedor con el mismo cliente (Gemini, Groq, Ollama...). Al volver a
# OpenAI hay que dejarla vacia de nuevo, o la clave se manda al otro proveedor.
OPENAI_BASE_URL=
# Alternativa: LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Alternativa: LLM_PROVIDER=local (Ollama en el host)
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3.1:8b

# --- Proveedor de embeddings (pieza aparte: Anthropic no genera embeddings) ---
# openai reutiliza OPENAI_API_KEY: todo el corpus cuesta ~1 centavo.
EMBEDDING_PROVIDER=openai         # openai | local | hosted
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_DIM=1024                # debe coincidir con la columna VECTOR(1024) del esquema
# Endpoint compatible con OpenAI para embeddings (independiente del LLM).
EMBEDDING_OPENAI_BASE_URL=
# Credencial propia de los embeddings. Vacia = se usa OPENAI_API_KEY. Solo hace
# falta cuando el LLM y los embeddings son de proveedores distintos.
EMBEDDING_OPENAI_API_KEY=
# Tope de textos por minuto (0 = sin limite). Solo para proveedores con cuota.
EMBEDDING_RPM=0
# Alternativa: EMBEDDING_PROVIDER=local (Ollama, gratis y offline).
# Requiere `ollama pull bge-m3` en el host. Desde el contenedor, Ollama se
# alcanza por host.docker.internal, no por localhost.
EMBEDDING_MODEL_LOCAL=bge-m3      # multilingue, 1024 dims
EMBEDDING_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
# Alternativa: EMBEDDING_PROVIDER=hosted (Voyage).
EMBEDDING_MODEL_HOSTED=voyage-3
VOYAGE_API_KEY=

# --- RAG (recuperacion) — controlan el contexto y el gasto de tokens ---
RAG_K_POR_CONSULTA=4              # fragmentos por cada consulta del LLM
RAG_MAX_FRAGMENTOS=10             # tope total de fragmentos enviados al analisis

# --- Opcional: probar Gemini como proveedor alternativo ---
# Solo lo lee deploy/probar_gemini.sh, que valida el proveedor en un contenedor
# aparte sin tocar tu configuracion. Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Despliegue ---
# Origenes permitidos por CORS, separados por coma. "*" abre todo (solo local).
CORS_ORIGINS=*
# APP_ENV=prod desactiva el --reload de uvicorn (ver entrypoint.sh).
APP_ENV=dev

# --- Frontend ---
# URL del backend vista desde el navegador del usuario.
# (8001 en el host porque 8000 suele estar ocupado; ver docker-compose.yml)
NEXT_PUBLIC_API_URL=http://localhost:8001
