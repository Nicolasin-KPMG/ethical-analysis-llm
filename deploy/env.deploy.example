# ==========================================================================
# .env para el DESPLIEGUE (demo). Copia este archivo a  .env  en el servidor
# y rellena lo marcado con  <<< ... >>>.  NO subas este .env a git.
# ==========================================================================

# --- Base de datos (Postgres + pgvector, dentro de docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<<< PON_UNA_CLAVE_FUERTE >>>     # p. ej. openssl rand -hex 16
POSTGRES_DB=tesis
DATABASE_URL=postgresql://postgres:<<< MISMA_CLAVE_DE_ARRIBA >>>@db:5432/tesis

# --- Autenticación (JWT) ---
JWT_SECRET=<<< openssl rand -hex 32 >>>            # ¡genera uno nuevo!
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- LLM: OpenAI (lo que ya usas) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=<<< TU_OPENAI_API_KEY >>>
OPENAI_MODEL=gpt-4.1
# (Anthropic opcional; déjalo vacío si no lo usas en la demo)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embeddings: OpenAI (reutiliza la misma OPENAI_API_KEY, sin Ollama ni Voyage) ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_DIM=1024
VOYAGE_API_KEY=

# --- RAG ---
RAG_K_POR_CONSULTA=4
RAG_MAX_FRAGMENTOS=10

# --- Frontend ---
# IMPRESCINDIBLE: la IP pública de tu droplet (la ve el navegador de tu jefe).
# Sustituye  TU_IP_PUBLICA  por la IP real del servidor.
NEXT_PUBLIC_API_URL=http://TU_IP_PUBLICA:8001
